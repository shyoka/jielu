<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        注意：parent 必须是 NoActionBar。
        Wear OS 真机上的 Theme.DeviceDefault 恰好没有 ActionBar，但完整 Android 系统的手表
        （以及部分国产 ROM）会带一个标题栏，一直显示 @string/app_name，且无法划走。
    -->
    <style name="Theme.JieluWear" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#E8B4A0</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
